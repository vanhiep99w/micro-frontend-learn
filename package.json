{
  "name": "micro-frontend-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:visuals": "node scripts/docs-kit-audit.mjs --check",
    "check:export": "node scripts/check-export.mjs",
    "build:source": "node scripts/build-source-examples.mjs",
    "check:source": "node scripts/check-source-examples.mjs",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "npm run build:source",
    "watch:source": "node scripts/watch-source-examples.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve-export.mjs"
  },
  "dependencies": {
    "@vanhiep99w/docs-kit": "0.9.8",
    "fumadocs-core": "16.17.5",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.5",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chokidar": "5.0.0",
    "postcss": "^8",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "11.0.5"
  }
}
