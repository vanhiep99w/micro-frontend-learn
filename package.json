{
  "name": "micro-frontend-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "fumadocs-mdx",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:export": "node scripts/check-export.mjs",
    "build:source": "node scripts/build-source-examples.mjs",
    "check:source": "node scripts/check-source-examples.mjs",
    "test": "node --test tests/*.test.mjs",
    "predev": "npm run build:source",
    "prebuild": "npm run build:source"
  },
  "dependencies": {
    "@vanhiep99w/docs-kit": "0.5.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.1",
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "11.0.5"
  }
}
